DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

POSTGRES_DB=bahasha_db
POSTGRES_USER=bahasha
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

WEB_PORT=8000
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Bahasha <noreply@your-domain.com>

# Vodacom Tanzania M-Pesa Open API. Keep disabled until sandbox verification is
# complete. Store the PEM public key on one line using literal \n separators.
PAYMENTS_ENABLED=False
PAYMENT_PROVIDER=vodacom_m_pesa
MPESA_ENABLED=False
MPESA_ENVIRONMENT=sandbox
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_MARKET=vodacomTZN
MPESA_COUNTRY=TZN
MPESA_CURRENCY=TZS
MPESA_TIMEOUT_SECONDS=20

# Airtel Money Tanzania. Confirm the paths assigned to the approved application
# before enabling the adapter in sandbox or production.
AIRTEL_MONEY_ENABLED=False
AIRTEL_MONEY_ENVIRONMENT=sandbox
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=TZ
AIRTEL_MONEY_CURRENCY=TZS
AIRTEL_MONEY_TOKEN_PATH=auth/oauth2/token
AIRTEL_MONEY_COLLECTION_PATH=merchant/v1/payments/
AIRTEL_MONEY_QUERY_PATH=standard/v1/payments/{transaction_id}
AIRTEL_MONEY_TIMEOUT_SECONDS=20

# Mixx by Yas endpoints and credentials are supplied during merchant onboarding.
# Do not enable this adapter until its exact contract has been confirmed.
MIXX_ENABLED=False
MIXX_ENVIRONMENT=sandbox
MIXX_BASE_URL=
MIXX_CLIENT_ID=
MIXX_CLIENT_SECRET=
MIXX_MERCHANT_CODE=
MIXX_TOKEN_PATH=
MIXX_COLLECTION_PATH=
MIXX_QUERY_PATH=
MIXX_COUNTRY=TZ
MIXX_CURRENCY=TZS
MIXX_TIMEOUT_SECONDS=20
